{
  "name": "@coreyhiggins/grain",
  "version": "0.11.1",
  "description": "Routes each prompt to the right discipline and injects only the guidance that matches. Costs nothing on conversational turns, and surfaces the skill you forgot you installed.",
  "bin": {
    "grain": "bin/grain.js"
  },
  "main": "src/analyze.js",
  "files": [
    "bin/",
    "src/",
    "hooks/",
    "commands/",
    "skills/",
    ".claude-plugin/",
    "README.md",
    "LICENSE",
    "examples/"
  ],
  "scripts": {
    "test": "node test/run-tests.js && node test/hygiene.js",
    "bench:routing": "node bench/routing.js bench/routing-corpus.json",
    "bench:followups": "node bench/followups.js",
    "bench:terse": "node bench/terse.js"
  },
  "keywords": [
    "claude-code",
    "plugin",
    "hook",
    "prompt-routing",
    "skills",
    "agent",
    "orchestration",
    "context",
    "tokens",
    "cursor"
  ],
  "author": "Corey Higgins",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coreyhiggins/grain.git"
  },
  "bugs": {
    "url": "https://github.com/coreyhiggins/grain/issues"
  },
  "homepage": "https://github.com/coreyhiggins/grain#readme",
  "engines": {
    "node": ">=18"
  }
}
